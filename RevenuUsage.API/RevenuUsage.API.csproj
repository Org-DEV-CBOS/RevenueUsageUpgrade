<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.11" />
    <PackageReference Include="QuestPDF" Version="2025.7.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="MediatR" Version="12.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced where the web app already keeps it rather than copied, so the logo
         on an exported report cannot drift from the one on screen. -->
    <Content Include="..\revenue-usage-ui\public\cbos-logo-blue.png"
             Link="Exports\Assets\cbos-logo-blue.png"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevenuUsage.Application\RevenuUsage.Application.csproj" />
    <ProjectReference Include="..\RevenuUsage.Infrastructure\RevenuUsage.Infrastructure.csproj" />
  </ItemGroup>

</Project>
